<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_workout_template_list" model="ir.ui.view">
        <field name="name">gym.workout.template.list</field>
        <field name="model">gym.workout.template</field>
        <field name="arch" type="xml">
            <list string="Workout Templates">
                <field name="name"/>
                <field name="goal_type"/>
                <field name="duration_weeks"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gym_workout_template_form" model="ir.ui.view">
        <field name="name">gym.workout.template.form</field>
        <field name="model">gym.workout.template</field>
        <field name="arch" type="xml">
            <form string="Workout Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workout_plans" type="object"
                                class="oe_stat_button" icon="fa-fire">
                            <field name="workout_plan_count" widget="statinfo" string="Workout Plans"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="goal_type"/>
                            <field name="duration_weeks"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this template..."/>
                    <notebook>
                        <page string="Exercise Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="day_of_week"/>
                                    <field name="exercise_id"/>
                                    <field name="exercise_category_id" optional="show"/>
                                    <field name="exercise_equipment_ids" column_invisible="1"/>
                                    <field name="equipment_id"/>
                                    <field name="sets"/>
                                    <field name="reps"/>
                                    <field name="rest_seconds"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_workout_template_search" model="ir.ui.view">
        <field name="name">gym.workout.template.search</field>
        <field name="model">gym.workout.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="goal_type"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group>
                    <filter name="group_goal" string="Goal Type" context="{'group_by': 'goal_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_workout_template" model="ir.actions.act_window">
        <field name="name">Workout Templates</field>
        <field name="res_model">gym.workout.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gym_workout_template_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No workout templates yet</p>
            <p>Create reusable workout templates to quickly build personalised member plans.</p>
        </field>
    </record>

</odoo>
