<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_gym_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.gym.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Portal user creation -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_portal_user" string="Create Portal User"
                            type="object" class="btn-primary"
                            invisible="not is_member or has_portal_user"
                            groups="eb_gym_management.group_gym_manager,eb_gym_management.group_gym_branch_manager"/>
                </header>
            </xpath>

            <!-- Membership smart button -->
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_view_memberships" type="object"
                        class="oe_stat_button" icon="fa-id-card"
                        invisible="membership_count == 0">
                    <field name="membership_count" widget="statinfo" string="Memberships"/>
                </button>
                <button name="action_view_attendance" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="attendance_count == 0">
                    <field name="attendance_count" widget="statinfo" string="Attendance"/>
                </button>
            </xpath>

            <!-- Hide business fields not relevant for gym members -->
            <field name="vat" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="website" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="function" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="category_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="lang" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Hide irrelevant tabs -->
            <page name="contact_addresses" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>
            <page name="sales_purchases" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>

            <!-- Add Gym Info tab -->
            <page name="internal_notes" position="before">
                <page string="Gym Info" name="gym_info">
                    <group>
                        <field name="is_member"/>
                    </group>
                    <field name="membership_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="plan_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-info="state == 'on_hold'"
                                   decoration-warning="state == 'draft'"
                                   decoration-danger="state == 'expired'"
                                   decoration-muted="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </page>

        </field>
    </record>

    <!-- Members list action -->
    <record id="action_gym_members" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_member', '=', True)]</field>
        <field name="context">{'default_is_member': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No members yet</p>
            <p>Add contacts and mark them as gym members to get started.</p>
        </field>
    </record>

</odoo>
