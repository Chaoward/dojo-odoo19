<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Gym-facing views for Odoo's standard hr.attendance model - the Gym
         Management menu keeps its own simple "Staff Attendance" screen
         instead of sending reception/trainers/nutritionists into the
         separate Attendances app, but the underlying data is the standard
         model (no parallel gym-specific attendance model). -->

    <record id="view_gym_staff_attendance_list" model="ir.ui.view">
        <field name="name">hr.attendance.gym.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Staff Attendance" editable="bottom"
                  decoration-success="check_out != False"
                  decoration-warning="not check_out">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_gym_staff_attendance_form" model="ir.ui.view">
        <field name="name">hr.attendance.gym.form</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <form string="Staff Attendance">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                        </group>
                        <group>
                            <field name="worked_hours" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_staff_attendance_search" model="ir.ui.view">
        <field name="name">hr.attendance.gym.search</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="today" string="Today"
                        domain="[('check_in', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="checked_in" string="Still Checked In" domain="[('check_out', '=', False)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_staff_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gym_staff_attendance_list"/>
        <field name="search_view_id" ref="view_gym_staff_attendance_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No staff attendance records yet</p>
            <p>Use Check In / Check Out to record staff attendance, or add a row here directly.</p>
        </field>
    </record>

    <record id="action_gym_staff_attendance_recent" model="ir.actions.act_window">
        <field name="name">Recent Staff Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_gym_staff_attendance_list"/>
        <field name="search_view_id" ref="view_gym_staff_attendance_search"/>
        <field name="context">{'search_default_today': 1, 'search_default_checked_in': 1}</field>
    </record>

</odoo>
