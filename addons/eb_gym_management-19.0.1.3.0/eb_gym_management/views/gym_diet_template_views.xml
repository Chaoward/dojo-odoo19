<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_diet_template_list" model="ir.ui.view">
        <field name="name">gym.diet.template.list</field>
        <field name="model">gym.diet.template</field>
        <field name="arch" type="xml">
            <list string="Diet Templates">
                <field name="name"/>
                <field name="goal_type"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_gym_diet_template_form" model="ir.ui.view">
        <field name="name">gym.diet.template.form</field>
        <field name="model">gym.diet.template</field>
        <field name="arch" type="xml">
            <form string="Diet Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_diet_plans" type="object"
                                class="oe_stat_button" icon="fa-cutlery">
                            <field name="diet_plan_count" widget="statinfo" string="Diet Plans"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="goal_type"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this template..."/>
                    <notebook>
                        <page string="Meal Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="meal_type"/>
                                    <field name="food_id"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_diet_template_search" model="ir.ui.view">
        <field name="name">gym.diet.template.search</field>
        <field name="model">gym.diet.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="goal_type"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group>
                    <filter name="group_goal" string="Goal Type" context="{'group_by': 'goal_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_diet_template" model="ir.actions.act_window">
        <field name="name">Diet Templates</field>
        <field name="res_model">gym.diet.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gym_diet_template_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
