<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_attendance_list" model="ir.ui.view">
        <field name="name">gym.attendance.list</field>
        <field name="model">gym.attendance</field>
        <field name="arch" type="xml">
            <list string="Member Attendance"
                  decoration-success="check_out != False"
                  decoration-warning="not check_out" duplicate="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration" widget="float_time"/>
                <field name="workout_plan_id" optional="show"
                       groups="eb_gym_management.group_gym_trainer,eb_gym_management.group_gym_nutritionist,eb_gym_management.group_gym_branch_manager,eb_gym_management.group_gym_manager"/>
                <button name="action_check_out" type="object" string="Check Out"
                        icon="fa-sign-out" invisible="check_out != False"
                        groups="eb_gym_management.group_gym_reception,eb_gym_management.group_gym_branch_manager,eb_gym_management.group_gym_manager"/>
            </list>
        </field>
    </record>

    <record id="view_gym_attendance_form" model="ir.ui.view">
        <field name="name">gym.attendance.form</field>
        <field name="model">gym.attendance</field>
        <field name="arch" type="xml">
            <form string="Member Attendance" duplicate="0">
                <header>
                    <button name="action_check_out" string="Check Out" type="object"
                            class="btn-primary" invisible="check_out != False"
                            groups="eb_gym_management.group_gym_reception,eb_gym_management.group_gym_branch_manager,eb_gym_management.group_gym_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="membership_id"
                                   domain="[('partner_id', '=', partner_id), ('state', '=', 'active')]"/>
                            <field name="workout_plan_id"
                                   domain="[('membership_id', '=', membership_id), ('state', '=', 'active')]"
                                   groups="eb_gym_management.group_gym_trainer,eb_gym_management.group_gym_nutritionist,eb_gym_management.group_gym_branch_manager,eb_gym_management.group_gym_manager"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_attendance_search" model="ir.ui.view">
        <field name="name">gym.attendance.search</field>
        <field name="model">gym.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <filter name="today" string="Today"
                        domain="[('check_in', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="checked_in" string="Still Checked In" domain="[('check_out', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Member" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot for Attendance Analysis -->
    <record id="view_gym_attendance_pivot" model="ir.ui.view">
        <field name="name">gym.attendance.pivot</field>
        <field name="model">gym.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Attendance Analysis">
                <field name="check_in" type="row" interval="day"/>
                <field name="partner_id" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_gym_attendance_graph" model="ir.ui.view">
        <field name="name">gym.attendance.graph</field>
        <field name="model">gym.attendance</field>
        <field name="arch" type="xml">
            <graph string="Attendance Analysis" type="bar">
                <field name="check_in" type="row" interval="day"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_gym_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">gym.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_gym_attendance_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No attendance records yet</p>
            <p>Check in a member to start tracking gym attendance.</p>
        </field>
    </record>

    <record id="action_gym_attendance_analysis" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">gym.attendance</field>
        <field name="view_mode">pivot,graph</field>
    </record>

</odoo>
