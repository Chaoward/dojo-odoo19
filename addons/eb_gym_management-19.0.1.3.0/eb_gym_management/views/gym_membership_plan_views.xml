<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Extend product.template FORM to show gym fields ────────────────── -->
    <record id="view_product_template_gym_plan_form" model="ir.ui.view">
        <field name="name">product.template.gym.plan.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Memberships smart button, only for gym membership plan products -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_gym_memberships" type="object"
                        class="oe_stat_button" icon="fa-users"
                        invisible="not is_gym_membership_plan">
                    <field name="gym_membership_count" widget="statinfo" string="Memberships"/>
                </button>
            </xpath>

            <!-- Move membership plan settings INTO the notebook as a tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Membership Plan" invisible="not is_gym_membership_plan" name="gym_membership_plan">
                    <group string="Plan Settings">
                        <group>
                            <field name="gym_plan_code" placeholder="e.g. MONTHLY-01"/>
                            <field name="gym_duration_value"/>
                            <field name="gym_duration_uom"/>
                        </group>
                        <group string="What's Included">
                            <field name="gym_includes_workout"/>
                            <field name="gym_includes_diet"/>
                        </group>
                    </group>
                    <separator string="Benefits"/>
                    <field name="gym_benefits"
                           placeholder="List the benefits of this membership plan…"
                           nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ─── Standalone List View ────────────────────────────────────────────── -->
    <record id="view_gym_membership_plan_list" model="ir.ui.view">
        <field name="name">gym.membership.plan.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Membership Plans">
                <field name="name" string="Plan Name"/>
                <field name="gym_plan_code" string="Code"/>
                <field name="gym_duration_value" string="Duration"/>
                <field name="gym_duration_uom" string="Unit"/>
                <field name="gym_includes_workout" string="Workout" optional="show" widget="boolean_toggle"/>
                <field name="gym_includes_diet" string="Diet" optional="show" widget="boolean_toggle"/>
                <field name="list_price" string="Price" widget="monetary"/>
                <field name="currency_id" optional="hide"/>
                <field name="gym_membership_count" string="Memberships" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ─── Standalone Form View ────────────────────────────────────────────── -->
    <record id="view_gym_membership_plan_form" model="ir.ui.view">
        <field name="name">gym.membership.plan.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Membership Plan">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_gym_memberships" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="gym_membership_count" widget="statinfo" string="Memberships"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Plan Name"/>
                        <h1><field name="name" placeholder="e.g. Monthly Bronze"/></h1>
                    </div>
                    <group>
                        <group string="Plan Details">
                            <field name="gym_plan_code" placeholder="e.g. MONTHLY-01"/>
                            <field name="gym_duration_value"/>
                            <field name="gym_duration_uom"/>
                        </group>
                        <group string="Pricing">
                            <field name="list_price" string="Price"/>
                            <field name="currency_id"/>
                            <field name="taxes_id" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="What's Included">
                        <field name="gym_includes_workout"/>
                        <field name="gym_includes_diet"/>
                    </group>
                    <group string="Product Configuration" groups="base.group_no_one">
                        <field name="type"/>
                        <field name="invoice_policy"/>
                    </group>
                    <notebook>
                        <page string="Benefits">
                            <field name="gym_benefits" placeholder="List the benefits of this membership plan…"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description_sale" placeholder="Terms and conditions visible on sales orders…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Search View ─────────────────────────────────────────────────────── -->
    <record id="view_gym_membership_plan_search" model="ir.ui.view">
        <field name="name">gym.membership.plan.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Plan Name"/>
                <field name="gym_plan_code" string="Code"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="membership_plans" string="Membership Plans Only"
                        domain="[('is_gym_membership_plan','=',True)]"/>
                <filter name="includes_workout" string="Includes Workout"
                        domain="[('gym_includes_workout','=',True)]"/>
                <filter name="includes_diet" string="Includes Diet"
                        domain="[('gym_includes_diet','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- ─── Window Action ───────────────────────────────────────────────────── -->
    <record id="action_gym_membership_plan" model="ir.actions.act_window">
        <field name="name">Membership Plans</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_gym_membership_plan', '=', True)]</field>
        <field name="search_view_id" ref="view_gym_membership_plan_search"/>
        <field name="context">{
            'default_is_gym_membership_plan': True,
            'default_type': 'service',
            'default_invoice_policy': 'order',
            'search_default_active': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Membership Plan
            </p>
            <p>
                Define gym membership plans here. Each plan is a service product.
                Set the duration, price, and benefits that members will enjoy.
            </p>
        </field>
    </record>

</odoo>
