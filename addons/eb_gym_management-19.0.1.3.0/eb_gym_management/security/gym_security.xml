            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Gym groups may only see employees linked to a gym role user (trainer/
             nutritionist/reception), not the full HR employee directory. Manager gets
             the same "gym staff only" scope here (rather than a broader override like
             the rules above) since browsing the whole company's HR data is out of scope
             for this module even for gym managers; it still gets write/create per its ACL.
             Odoo system administrators are exempt so the built-in Administrator user can
             manage every employee record without being trapped by this module's scope. -->
        <record id="rule_hr_employee_gym_staff" model="ir.rule">
            <field name="name">Employee: Trainer/Nutritionist/Reception see gym staff only</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('group_gym_trainer')), (4, ref('group_gym_nutritionist')), (4, ref('group_gym_reception'))]"/>
            <field name="domain_force">user._is_admin() and [(1, '=', 1)] or ['|', '|', ('is_receptionist', '=', True), ('is_trainer', '=', True), ('is_nutritionist', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- The ACL row for reception (access_hr_employee_gym_reception) already sets
             write/create/unlink to 0, but group_gym_reception implies hr.group_hr_user,
             whose own ACL (hr's access_hr_employee_user) grants full CRUD on hr.employee -
             and Odoo ACL checks OR every matching group's access together, so that implied
             "Officer" access silently wins over this module's read-only intent. A domain
             that never matches any record is the standard way to force a real denial: this
             rule applies (perm_*=True) to write/create/unlink, but since [(0, '=', 1)] is
             always false, no record - existing or newly created - ever satisfies it, so
             those operations are always rejected for reception regardless of the ACL bit. -->
        <record id="rule_hr_employee_gym_reception_readonly" model="ir.rule">
            <field name="name">Employee: Reception is read-only (blocks write inherited from hr.group_hr_user)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('group_gym_reception'))]"/>
            <field name="domain_force">user._is_admin() and [(1, '=', 1)] or [(0, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

