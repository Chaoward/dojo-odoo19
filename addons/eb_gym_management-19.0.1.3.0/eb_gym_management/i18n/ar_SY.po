"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;\">\n"
"<tr><td align=\"center\">\n"
