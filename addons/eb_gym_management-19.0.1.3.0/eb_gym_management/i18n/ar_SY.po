"    <tr>\n"
"        <td style=\"background-color:#714B67; padding:24px 32px;\">\n"
"            <span style=\"color:#ffffff; font-size:20px; font-weight:bold;\"><t t-out=\"user.company_id.name\"/> Gym</span>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"padding:32px;\">\n"
"            <p style=\"margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;\">Health Assessment</p>\n"
"            <h1 style=\"margin:0 0 16px 0; color:#1f2933; font-size:22px;\">Dear <t t-out=\"object.partner_id.name\"/>,</h1>\n"
"            <p style=\"margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Your health assessment has been completed by your trainer.\n"
"            </p>\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;\">\n"
"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;\">Assessment Reference</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.name\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Date</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"format_date(object.date)\"/></td>\n"
"                </tr>\n"
"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Height</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.height_cm\"/> cm</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Weight</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.weight_kg\"/> kg</td>\n"
"                </tr>\n"
"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">BMI</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.bmi\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Fitness Goal</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.goal\"/></td>\n"
"                </tr>\n"
"                <t t-if=\"object.trainer_id\">\n"
"                    <tr style=\"background-color:#f9f9fb;\">\n"
"                        <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Trainer</td>\n"
"                        <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.trainer_id.name\"/></td>\n"
"                    </tr>\n"
"                </t>\n"
"            </table>\n"
"            <p style=\"margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Your trainer will use these results to design a personalised workout and diet plan for you.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Gym Management Team</span>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
