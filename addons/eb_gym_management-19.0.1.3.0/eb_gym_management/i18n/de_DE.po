"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px;font-size:13px;font-weight:bold; color:#1f2933; width:45%;\">Bewertungsreferenz</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.name\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Datum</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"format_date(object.date)\"/></td>\n"
"                </tr>\n"
"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Höhe</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.height_cm\"/> cm</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px;font-size:13px;font-weight:bold; color:#1f2933;\">Gewicht</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.weight_kg\"/> kg</td>\n"
"                </tr>\n"
"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">BMI</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.bmi\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Fitnessziel</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.goal\"/></td>\n"
"                </tr>\n"
"                <t t-if=\"object.trainer_id\">\n"
"                    <tr style=\"background-color:#f9f9fb;\">\n"
"                        <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Trainer</td>\n"
"                        <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.trainer_id.name\"/></td>\n"
"                    </tr>\n"
"                </t>\n"
"            </table>\n"
"            <p style=\"margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Anhand dieser Ergebnisse erstellt Ihr Trainer einen individuellen Trainings- und Diätplan für Sie.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Fitnessstudio-Management-Team</span>\n"
"        </td>\n"
"    </tr>\n"
