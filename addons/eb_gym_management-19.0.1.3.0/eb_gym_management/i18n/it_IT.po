"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;\">\n"
"<tr><td align=\"center\">\n"
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;\">\n"
"    <tr>\n"
"        <td style=\"background-color:#714B67; padding:24px 32px;\">\n"
"            <span style=\"color:#ffffff; font-size:20px; font-weight:bold;\"><t t-out=\"user.company_id.name\"/> Gym</span>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"padding:32px;\">\n"
"            <p style=\"margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;\">Renewal Reminder</p>\n"
"            <h1 style=\"margin:0 0 16px 0; color:#1f2933; font-size:22px;\">Dear <t t-out=\"object.partner_id.name\"/>,</h1>\n"
"            <p style=\"margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                This is a friendly reminder that your gym membership will\n"
"                <span style=\"display:inline-block; background-color:#fff8e1; color:#a97400; font-weight:bold; font-size:12px; padding:2px 10px; border-radius:12px;\">EXPIRE SOON</span>\n"
"            </p>\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;\">\n"
"                <tr style=\"background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;\">Membership Reference</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.name\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Plan</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.plan_id.name\"/></td>\n"
"                </tr>\n"
"                <tr style=\"background-color:#fff8e1;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;\">Expiry Date</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;\"><t t-out=\"format_date(object.end_date)\"/></td>\n"
"                </tr>\n"
"            </table>\n"
"            <p style=\"margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Please visit the gym or contact us to renew your membership and continue your fitness journey without interruption.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Gym Management Team</span>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
"            "
msgstr ""
"<table border=\"0\" cellpadding=\"0\" cellulespacing=\"0\" larghezza=\"100%\" style=\" background-color:#f4f4f7; imbottitura:32px 0; font-family: Helvetica, Arial, sans-serif;\">\n"
"<tr><td align=\"center\">\n"
"<table border=\"0\" cellpadding=\"0\" cellulespacing=\"0\" larghezza=\"600\" style=\"max-width:600px; larghezza:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;\">\n"
"    <tr>\n"
"        <td style=\" background-color:#714B67; imbottitura:24px 32px;\">\n"
"            <span style=\"color:#ffffff; font-size:20px; font-weight:bold;\"><t t-out=\"user.company_id.name\"/> Palestra</span>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"padding:32px;\">\n"
"            <p style=\"margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;\">Promemoria di rinnovo</p>\n"
"            <h1 style=\"margin:0 0 16px 0; color:#1f2933; font-size:22px;\">Caro <t t-out=\"object.partner_id.name\"/>,</h1>\n"
"            <p style=\"margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Questo è un promemoria amichevole che il tuo abbonamento alla palestra lo farà\n"
"                <span style=\"display:inline-block; background-color:#fff8e1; color:#a97400; font-weight:bold; font-size:12px; padding:2px 10px; border-radius:12px;\">SCADONO PRESTO</span>\n"
"            </p>\n"
"            <table border=\"0\" cellpadding=\"0\" cellulespacing=\"0\" width=\"100%\" style=\"border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;\">\n"
"                <tr style=\" background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; larghezza:45%;\">Riferimento iscrizione</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.name\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Pianifica</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.plan_id.name\"/></td>\n"
"                </tr>\n"
"                <tr style=\" background-color:#fff8e1;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;\">Data di scadenza</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;\"><t t-out=\"format_date(object.end_date)\"/></td>\n"
"                </tr>\n"
"            </tabella>\n"
"            <p style=\"margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Visita la palestra o contattaci per rinnovare la tua iscrizione e continuare il tuo percorso di fitness senza interruzioni.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\" background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Team di gestione della palestra</span>\n"
"        </td>\n"
"    </tr>\n"
"</tabella>\n"
"</td></tr>\n"
"</tabella>"

