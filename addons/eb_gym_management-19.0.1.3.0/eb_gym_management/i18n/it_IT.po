"            <h1 style=\"margin:0 0 16px 0; color:#1f2933; font-size:22px;\">Caro <t t-out=\"object.partner_id.name\"/>,</h1>\n"
"            <p style=\"margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                La tua valutazione sanitaria è stata completata dal tuo allenatore.\n"
"            </p>\n"
"            <table border=\"0\" cellpadding=\"0\" cellulespacing=\"0\" width=\"100%\" style=\"border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;\">\n"
"                <tr style=\" background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;\">Riferimento per la valutazione</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.name\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Data</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"format_date(object.date)\"/></td>\n"
"                </tr>\n"
"                <tr style=\" background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Altezza</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.height_cm\"/> cm</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Peso</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.weight_kg\"/> kg</td>\n"
"                </tr>\n"
"                <tr style=\" background-color:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">IMC</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.bmi\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Obiettivo fitness</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.goal\"/></td>\n"
"                </tr>\n"
"                <t t-if=\"object.trainer_id\">\n"
"                    <tr style=\" background-color:#f9f9fb;\">\n"
"                        <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Trainer</td>\n"
"                        <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.trainer_id.name\"/></td>\n"
"                    </tr>\n"
"                </t>\n"
"            </tabella>\n"
"            <p style=\"margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Il tuo allenatore utilizzerà questi risultati per progettare un allenamento e un programma di dieta personalizzati per te.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\" background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Team di gestione della palestra</span>\n"
"        </td>\n"
"    </tr>\n"
"</tabella>\n"
"</td></tr>\n"
"</tabella>"

