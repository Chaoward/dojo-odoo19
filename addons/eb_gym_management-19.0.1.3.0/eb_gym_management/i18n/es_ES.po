"                <tr estilo=\"color-de-fondo:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;\">Referencia de evaluación</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.name\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Fecha</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"format_date(object.date)\"/></td>\n"
"                </tr>\n"
"                <tr estilo=\"color-de-fondo:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Alto</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.height_cm\"/> cm</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Peso</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.weight_kg\"/> kg</td>\n"
"                </tr>\n"
"                <tr estilo=\"color-de-fondo:#f9f9fb;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">IMC</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.bmi\"/></td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Objetivo de fitness</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.goal\"/></td>\n"
"                </tr>\n"
"                <t t-if=\"objeto.trainer_id\">\n"
"                    <tr estilo=\"color-de-fondo:#f9f9fb;\">\n"
"                        <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Entrenador</td>\n"
"                        <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.trainer_id.name\"/></td>\n"
"                    </tr>\n"
"                </t>\n"
"            </tabla>\n"
"            <p estilo=\"margin:24px 0 0 0; color:#52606d; tamaño de fuente:14px; altura de línea:22px;\">\n"
"                Su entrenador utilizará estos resultados para diseñar un plan de dieta y entrenamiento personalizado para usted.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"fondo-color:#f9f9fb; relleno:16px 32px; text-align:center; borde superior:1px sólido #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Equipo de gestión del gimnasio</span>\n"
"        </td>\n"
"    </tr>\n"
"</tabla>\n"
"</td></tr>\n"
"</tabla>"

