"                <tr style=\"background-color:#fff8e1;\">\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;\">Data de expirare</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;\"><t t-out=\"format_date(object.end_date)\"/></td>\n"
"                </tr>\n"
"            </tabel>\n"
"            <p style=\"margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Vă rugăm să vizitați sala de sport sau să ne contactați pentru a vă reînnoi abonamentul și pentru a vă continua călătoria de fitness fără întrerupere.\n"
"            </p>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;\">\n"
"            <span style=\"color:#9aa5b1; font-size:12px;\"><t t-out=\"user.company_id.name\"/> Echipa de management al sălii de sport</span>\n"
"        </td>\n"
"    </tr>\n"
"</tabel>\n"
"</td></tr>\n"
"</tabel>"

