"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;\">Planificați</td>\n"
"                    <td style=\"padding:10px 16px; font-size:13px; color:#52606d;\"><t t-out=\"object.plan_id.name\"/></td>\n"
