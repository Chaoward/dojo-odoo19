"            <h1 style=\"margin:0 0 16px 0; color:#1f2933; font-size:22px;\">Hello <t t-out=\"object.name\"/>, your member portal is ready</h1>\n"
"            <p style=\"margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;\">\n"
"                Your membership has been activated and a member portal account has been created for you.\n"
"                Click the button below to set your password and access your account.\n"
"            </p>\n"
"            <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\" style=\"margin:8px auto 24px auto;\">\n"
"                <tr>\n"
"                    <td align=\"center\" style=\"border-radius:6px; background-color:#714B67;\">\n"
"                        <a t-att-href=\"object._get_signup_url()\" target=\"_blank\" style=\"display:inline-block; padding:14px 32px; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:6px; font-family: Helvetica, Arial, sans-serif;\">\n"
"                            Set My Password\n"
"                        </a>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"            <p style=\"margin:0 0 8px 0; color:#1f2933; font-size:14px; font-weight:bold;\">From the portal you can:</p>\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n"
"                <tr>\n"
"                    <td style=\"padding:4px 0; color:#52606d; font-size:14px; line-height:22px;\">✓ View your membership</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:4px 0; color:#52606d; font-size:14px; line-height:22px;\">✓ View your workout plan</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:4px 0; color:#52606d; font-size:14px; line-height:22px;\">✓ View your diet plan</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:4px 0; color:#52606d; font-size:14px; line-height:22px;\">✓ Check your attendance</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:4px 0; color:#52606d; font-size:14px; line-height:22px;\">✓ View fitness reports</td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"padding:4px 0; color:#52606d; font-size:14px; line-height:22px;\">✓ Register for classes</td>\n"
