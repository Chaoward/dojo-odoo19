"    <tr>\n"
"        <td style=\"background-color:#714B67; padding:24px 32px;\">\n"
"            <span style=\"color:#ffffff; font-size:20px; font-weight:bold;\"><t t-out=\"user.company_id.name\"/> Salle de sport</span>\n"
"        </td>\n"
"    </tr>\n"
"    <tr>\n"
"        <td style=\"padding:32px;\">\n"
