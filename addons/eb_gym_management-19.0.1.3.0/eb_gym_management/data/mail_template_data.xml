<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Membership Welcome -->
        <record id="mail_template_membership_welcome" model="mail.template">
            <field name="name">Membership: Welcome</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="subject">Welcome to the Gym, {{ object.partner_id.name }}!</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
    <tr>
        <td style="background-color:#714B67; padding:24px 32px;">
            <span style="color:#ffffff; font-size:20px; font-weight:bold;"><t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <p style="margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;">Membership Activated</p>
            <h1 style="margin:0 0 16px 0; color:#1f2933; font-size:22px;">You're all set, <t t-out="object.partner_id.name"/>!</h1>
            <p style="margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;">
                Great news — your gym membership is now
                <span style="display:inline-block; background-color:#e6f4ea; color:#28a745; font-weight:bold; font-size:12px; padding:2px 10px; border-radius:12px;">ACTIVE</span>
            </p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;">
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;">Membership Reference</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.name"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Plan</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.plan_id.name"/></td>
                </tr>
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Start Date</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="format_date(object.start_date)"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">End Date</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="format_date(object.end_date)"/></td>
                </tr>
                <t t-if="object.trainer_id">
                    <tr style="background-color:#f9f9fb;">
                        <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Assigned Trainer</td>
                        <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.trainer_id.name"/></td>
                    </tr>
                </t>
            </table>
            <p style="margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;">We look forward to supporting your fitness journey!</p>
        </td>
    </tr>
    <tr>
        <td style="background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;">
            <span style="color:#9aa5b1; font-size:12px;"><t t-out="user.company_id.name"/> Gym Management Team</span>
        </td>
    </tr>
</table>
</td></tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Portal Invitation -->
        <record id="mail_template_portal_invitation" model="mail.template">
            <field name="name">Membership: Portal Invitation</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Welcome to {{ user.company_id.name }} Gym — Set Up Your Portal Access</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
    <tr>
        <td style="background-color:#714B67; padding:24px 32px;">
            <span style="color:#ffffff; font-size:20px; font-weight:bold;"><t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <p style="margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;">Portal Access</p>
            <h1 style="margin:0 0 16px 0; color:#1f2933; font-size:22px;">Hello <t t-out="object.name"/>, your member portal is ready</h1>
            <p style="margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;">
                Your membership has been activated and a member portal account has been created for you.
                Click the button below to set your password and access your account.
            </p>
            <table border="0" cellspacing="0" cellpadding="0" align="center" style="margin:8px auto 24px auto;">
                <tr>
                    <td align="center" style="border-radius:6px; background-color:#714B67;">
                        <a t-att-href="object._get_signup_url()" target="_blank"
                           style="display:inline-block; padding:14px 32px; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:6px; font-family: Helvetica, Arial, sans-serif;">
                            Set My Password
                        </a>
                    </td>
                </tr>
            </table>
            <p style="margin:0 0 8px 0; color:#1f2933; font-size:14px; font-weight:bold;">From the portal you can:</p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
                <tr>
                    <td style="padding:4px 0; color:#52606d; font-size:14px; line-height:22px;">✓ View your membership</td>
                </tr>
                <tr>
                    <td style="padding:4px 0; color:#52606d; font-size:14px; line-height:22px;">✓ View your workout plan</td>
                </tr>
                <tr>
                    <td style="padding:4px 0; color:#52606d; font-size:14px; line-height:22px;">✓ View your diet plan</td>
                </tr>
                <tr>
                    <td style="padding:4px 0; color:#52606d; font-size:14px; line-height:22px;">✓ Check your attendance</td>
                </tr>
                <tr>
                    <td style="padding:4px 0; color:#52606d; font-size:14px; line-height:22px;">✓ View fitness reports</td>
                </tr>
                <tr>
                    <td style="padding:4px 0; color:#52606d; font-size:14px; line-height:22px;">✓ Register for classes</td>
                </tr>
            </table>
            <p style="margin:24px 0 0 0; color:#9aa5b1; font-size:12px; line-height:18px;">
                If the button above doesn't work, copy and paste this link into your browser:<br/>
                <a t-att-href="object._get_signup_url()" style="color:#714B67; word-break:break-all;" t-out="object._get_signup_url()"/>
            </p>
        </td>
    </tr>
    <tr>
        <td style="background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;">
            <span style="color:#9aa5b1; font-size:12px;">Thank you, <t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
</table>
</td></tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Expiry Reminder -->
        <record id="mail_template_membership_expiry_reminder" model="mail.template">
            <field name="name">Membership: Expiry Reminder</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="subject">Your Gym Membership Expires Soon — {{ object.name }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
    <tr>
        <td style="background-color:#714B67; padding:24px 32px;">
            <span style="color:#ffffff; font-size:20px; font-weight:bold;"><t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <p style="margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;">Renewal Reminder</p>
            <h1 style="margin:0 0 16px 0; color:#1f2933; font-size:22px;">Dear <t t-out="object.partner_id.name"/>,</h1>
            <p style="margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;">
                This is a friendly reminder that your gym membership will
                <span style="display:inline-block; background-color:#fff8e1; color:#a97400; font-weight:bold; font-size:12px; padding:2px 10px; border-radius:12px;">EXPIRE SOON</span>
            </p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;">
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;">Membership Reference</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.name"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Plan</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.plan_id.name"/></td>
                </tr>
                <tr style="background-color:#fff8e1;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;">Expiry Date</td>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#a97400;"><t t-out="format_date(object.end_date)"/></td>
                </tr>
            </table>
            <p style="margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;">
                Please visit the gym or contact us to renew your membership and continue your fitness journey without interruption.
            </p>
        </td>
    </tr>
    <tr>
        <td style="background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;">
            <span style="color:#9aa5b1; font-size:12px;"><t t-out="user.company_id.name"/> Gym Management Team</span>
        </td>
    </tr>
</table>
</td></tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Membership Expired -->
        <record id="mail_template_membership_expired" model="mail.template">
            <field name="name">Membership: Expired</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="subject">Your Gym Membership Has Expired — {{ object.name }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
    <tr>
        <td style="background-color:#714B67; padding:24px 32px;">
            <span style="color:#ffffff; font-size:20px; font-weight:bold;"><t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <p style="margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;">Membership Update</p>
            <h1 style="margin:0 0 16px 0; color:#1f2933; font-size:22px;">Dear <t t-out="object.partner_id.name"/>,</h1>
            <p style="margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;">
                Your gym membership has
                <span style="display:inline-block; background-color:#fdecea; color:#dc3545; font-weight:bold; font-size:12px; padding:2px 10px; border-radius:12px;">EXPIRED</span>
            </p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;">
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;">Membership Reference</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.name"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Plan</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.plan_id.name"/></td>
                </tr>
                <tr style="background-color:#fdecea;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#dc3545;">Expired On</td>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#dc3545;"><t t-out="format_date(object.end_date)"/></td>
                </tr>
            </table>
            <p style="margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;">
                We'd love to have you back! Please visit us to renew your membership and get back on track.
            </p>
        </td>
    </tr>
    <tr>
        <td style="background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;">
            <span style="color:#9aa5b1; font-size:12px;"><t t-out="user.company_id.name"/> Gym Management Team</span>
        </td>
    </tr>
</table>
</td></tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Membership Renewed -->
        <record id="mail_template_membership_renewed" model="mail.template">
            <field name="name">Membership: Renewed</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="subject">Membership Renewed — {{ object.name }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
    <tr>
        <td style="background-color:#714B67; padding:24px 32px;">
            <span style="color:#ffffff; font-size:20px; font-weight:bold;"><t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <p style="margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;">Membership Renewed</p>
            <h1 style="margin:0 0 16px 0; color:#1f2933; font-size:22px;">Thanks for renewing, <t t-out="object.partner_id.name"/>!</h1>
            <p style="margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;">
                Your gym membership has been successfully
                <span style="display:inline-block; background-color:#e6f4ea; color:#28a745; font-weight:bold; font-size:12px; padding:2px 10px; border-radius:12px;">RENEWED</span>
            </p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;">
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;">Membership Reference</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.name"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Plan</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.plan_id.name"/></td>
                </tr>
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">New End Date</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="format_date(object.end_date)"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Total Renewals</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.renewal_count"/></td>
                </tr>
                <t t-if="object.trainer_id">
                    <tr style="background-color:#f9f9fb;">
                        <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Assigned Trainer</td>
                        <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.trainer_id.name"/></td>
                    </tr>
                </t>
            </table>
            <p style="margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;">Keep up the great work and stay consistent!</p>
        </td>
    </tr>
    <tr>
        <td style="background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;">
            <span style="color:#9aa5b1; font-size:12px;"><t t-out="user.company_id.name"/> Gym Management Team</span>
        </td>
    </tr>
</table>
</td></tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Health Assessment Completed -->
        <record id="mail_template_health_assessment_confirmed" model="mail.template">
            <field name="name">Health Assessment: Completed</field>
            <field name="model_id" ref="model_gym_health_assessment"/>
            <field name="subject">Health Assessment Completed — {{ object.name }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f4f4f7; padding:32px 0; font-family: Helvetica, Arial, sans-serif;">
<tr><td align="center">
<table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #e6e6e6;">
    <tr>
        <td style="background-color:#714B67; padding:24px 32px;">
            <span style="color:#ffffff; font-size:20px; font-weight:bold;"><t t-out="user.company_id.name"/> Gym</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <p style="margin:0 0 8px 0; color:#714B67; font-size:12px; font-weight:bold; letter-spacing:0.5px; text-transform:uppercase;">Health Assessment</p>
            <h1 style="margin:0 0 16px 0; color:#1f2933; font-size:22px;">Dear <t t-out="object.partner_id.name"/>,</h1>
            <p style="margin:0 0 20px 0; color:#52606d; font-size:14px; line-height:22px;">
                Your health assessment has been completed by your trainer.
            </p>
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse; border:1px solid #e6e6e6; border-radius:6px; overflow:hidden;">
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933; width:45%;">Assessment Reference</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.name"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Date</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="format_date(object.date)"/></td>
                </tr>
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Height</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.height_cm"/> cm</td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Weight</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.weight_kg"/> kg</td>
                </tr>
                <tr style="background-color:#f9f9fb;">
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">BMI</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.bmi"/></td>
                </tr>
                <tr>
                    <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Fitness Goal</td>
                    <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.goal"/></td>
                </tr>
                <t t-if="object.trainer_id">
                    <tr style="background-color:#f9f9fb;">
                        <td style="padding:10px 16px; font-size:13px; font-weight:bold; color:#1f2933;">Trainer</td>
                        <td style="padding:10px 16px; font-size:13px; color:#52606d;"><t t-out="object.trainer_id.name"/></td>
                    </tr>
                </t>
            </table>
            <p style="margin:24px 0 0 0; color:#52606d; font-size:14px; line-height:22px;">
                Your trainer will use these results to design a personalised workout and diet plan for you.
            </p>
        </td>
    </tr>
    <tr>
        <td style="background-color:#f9f9fb; padding:16px 32px; text-align:center; border-top:1px solid #e6e6e6;">
            <span style="color:#9aa5b1; font-size:12px;"><t t-out="user.company_id.name"/> Gym Management Team</span>
        </td>
    </tr>
</table>
</td></tr>
</table>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
