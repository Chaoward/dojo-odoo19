<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Auto-Expire Memberships (daily at midnight) -->
        <record id="ir_cron_gym_auto_expire" model="ir.cron">
            <field name="name">Gym: Auto-Expire Memberships</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_expire()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Auto-Resume Hold Memberships (daily) -->
        <record id="ir_cron_gym_auto_resume_hold" model="ir.cron">
            <field name="name">Gym: Auto-Resume Hold Memberships</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_resume_hold()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Membership Expiry Reminder (daily, 7 days before end) -->
        <record id="ir_cron_gym_expiry_reminder" model="ir.cron">
            <field name="name">Gym: Membership Expiry Reminder</field>
            <field name="model_id" ref="model_gym_membership"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Auto Check-out Reminder (daily) -->
        <record id="ir_cron_gym_checkout_reminder" model="ir.cron">
            <field name="name">Gym: Long Check-in Reminder</field>
            <field name="model_id" ref="model_gym_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_checkout_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
