<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_membership_hold_wizard_form" model="ir.ui.view">
        <field name="name">gym.membership.hold.wizard.form</field>
        <field name="model">gym.membership.hold.wizard</field>
        <field name="arch" type="xml">
            <form string="Pause Membership">
                <group>
                    <field name="membership_id" readonly="1"/>
                    <field name="max_hold_days" readonly="1"/>
                    <field name="remaining_hold_days" readonly="1"/>
                    <field name="hold_from_date" readonly="0" required="1"/>
                    <field name="hold_to_date" readonly="0" required="1"/>
                    <field name="hold_days" readonly="1"/>
                    <field name="hold_reason" placeholder="Optional reason for the hold..."/>
                </group>
                <footer>
                    <button name="action_confirm_hold" string="Confirm Hold" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
