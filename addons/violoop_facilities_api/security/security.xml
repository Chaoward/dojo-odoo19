<odoo>
    <record id="group_violoop_facility_user" model="res.groups">
        <field name="name">Violoop Facilities User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_violoop_facility_manager" model="res.groups">
        <field name="name">Violoop Facilities Manager</field>
        <field name="implied_ids" eval="[(4, ref('violoop_facilities_api.group_violoop_facility_user'))]"/>
    </record>

    <record id="group_violoop_api" model="res.groups">
        <field name="name">Violoop API Integration</field>
        <field name="implied_ids" eval="[             (4, ref('violoop_facilities_api.group_violoop_facility_manager')),             (4, ref('eb_gym_management.group_gym_reception'))         ]"/>
    </record>

    </odoo>
